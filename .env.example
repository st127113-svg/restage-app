# Which image provider to use. "mock" needs no API key and runs out of
# the box; "gemini" calls Google's Gemini image model directly;
# "n8n" delegates generation to an n8n workflow instead (see README).
IMAGE_PROVIDER=mock

# Only needed when IMAGE_PROVIDER=gemini.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the image model id if Google has moved on to a
# newer one since this was written. Check
# https://ai.google.dev/gemini-api/docs/models
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Only needed when IMAGE_PROVIDER=n8n. The production webhook URL for
# the n8n workflow that builds the Nano Banana prompt and calls Gemini.
# N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/dwellwise-generate

# The frontend calls the n8n webhook directly from the browser (not
# through /api/generate) so the request isn't bound by Vercel's
# serverless function time limit -- the full round trip (image gen +
# furniture ID + Lazada product matching) can take well over a minute.
# Must be prefixed NEXT_PUBLIC_ so Next.js exposes it to client code.
# Same URL as N8N_WEBHOOK_URL above.
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/dwellwise-generate
