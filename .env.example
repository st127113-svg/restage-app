# Which image provider to use. "mock" needs no API key and runs out of
# the box; "gemini" calls Google's Gemini image model for real results.
IMAGE_PROVIDER=mock

# Only needed when IMAGE_PROVIDER=gemini.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the image model id if Google has moved on to a
# newer one since this was written. Check
# https://ai.google.dev/gemini-api/docs/models
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
